# Public Supabase settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for atomic trades, account reset, snapshots, and the leaderboard.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Alpaca Market Data credentials. Never prefix these with NEXT_PUBLIC_.
# Create keys at https://app.alpaca.markets — market data only. Do not enable live trading.
ALPACA_API_KEY=your-alpaca-key
ALPACA_API_SECRET=your-alpaca-secret

# Used in auth emails and the README. Local default:
NEXT_PUBLIC_APP_URL=http://localhost:3000
